    <script>
        const links = document.querySelectorAll('.navbar a');
        links.forEach(link => {
            if (link.href === window.location.href) {
                link.classList.add('active');
                // If the link is within a dropdown, add the active class to the parent dropdown button
                const dropdown = link.closest('.dropdown-content');
                if (dropdown) {
                    const parentLink = dropdown.previousElementSibling;
                    if (parentLink) {
                        parentLink.classList.add('active'); // Highlight the parent dropdown button
                    }
                }
                // If the link is a direct child of a dropdown, highlight the dropdown itself
                const parentDropdown = link.closest('.dropdown');
                if (parentDropdown) {
                    const dropbtn = parentDropdown.querySelector('.dropbtn');
                    if (dropbtn) {
                        dropbtn.classList.add('active'); // Add active class to the dropdown button
                    }
                }
            }
        });
        function toggleExpand(button) {
            const content = button.nextElementSibling;
            if (content.style.display === "block") {
                content.style.display = "none"; // Hide content
            } else {
                content.style.display = "block"; // Show content
            }
        }
    </script>
